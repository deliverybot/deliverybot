# Environment configuration.
ENVIRONMENT=development
NODE_ENV=development

# The public URL the app is served from, used for OAuth redirects. Set your
# GitHub App's callback URL to $BASE_URL/login/cb.
BASE_URL=http://localhost:3000

# GitHub App configuration.
CLIENT_ID=
CLIENT_SECRET=
APP_ID=
WEBHOOK_SECRET=

# Signs session cookies and encrypts stored sessions. Falls back to
# WEBHOOK_SECRET when empty.
SESSION_SECRET=
PRIVATE_KEY=

# GitHub logins, comma separated, that can open the admin dashboard at
# /_/admin.
ADMIN_GITHUB_LOGINS=

# Use `trace` to get verbose logging or `info` to show less.
LOG_LEVEL=debug
LOG_FORMAT=json

# Go to https://smee.io/new set this to the URL that you are redirected to.
WEBHOOK_PROXY_URL=

# Postgres connection. Leave empty to keep data in memory (tmp/db.json).
# `docker compose up -d` starts a matching database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deliverybot
