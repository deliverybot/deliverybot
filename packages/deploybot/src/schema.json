{
  "$id": "https://example.com/card.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Configuration housed at .github/deploy.yml",
  "type": "object",
  "patternProperties": {
    ".*": {
      "type": "object",
      "properties": {
        "auto_deploy_on": {
          "type": "string"
        },
        "transient_environment": {
          "type": "boolean"
        },
        "production_environment": {
          "type": "boolean"
        },
        "required_contexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "auto_merge": {
          "type": "boolean"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "type": {
                "enum": ["string", "boolean", "number", "choice"]
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": ["string", "number", "boolean"]
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": ["string", "number"]
                }
              }
            },
            "if": {
              "properties": {
                "type": {
                  "const": "choice"
                }
              },
              "required": ["type"]
            },
            "then": {
              "required": ["options"]
            }
          }
        }
      }
    }
  }
}
