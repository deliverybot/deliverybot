{
  "name": "@deliverybot/run",
  "version": "0.7.2",
  "type": "module",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib/*",
    "bundle/*",
    "config/*"
  ],
  "scripts": {
    "clean": "rm -rf lib bundle",
    "build": "tsc -b",
    "build:watch": "tsc -b --watch --preserveWatchOutput",
    "bundle": "webpack --config config/webpack.config.cjs",
    "bundle:watch": "webpack --config config/webpack.config.cjs --watch",
    "run": "node lib/server.js",
    "worker": "node lib/worker.js",
    "sync-installations": "node lib/sync-installations.js"
  },
  "dependencies": {
    "@deliverybot/app": "0.7.2",
    "@deliverybot/client": "0.7.2",
    "@deliverybot/core": "0.7.2",
    "@deliverybot/postgres": "0.7.2",
    "dotenv": "8.2.0"
  },
  "devDependencies": {
    "css-loader": "7.1.5",
    "html-webpack-plugin": "5.6.8",
    "mini-css-extract-plugin": "2.10.2",
    "typescript": "5.6.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  },
  "description": "Controls and configures deployments using the GitHub API.",
  "author": "Deliverybot <support@deliverybot.dev> (https://github.com/deliverybot/deliverybot)",
  "license": "MIT",
  "support": "support@deliverybot.dev",
  "repository": "https://github.com/deliverybot/deliverybot",
  "homepage": "https://deliverybot.dev",
  "documentation": "https://deliverybot.dev/docs/",
  "bugs": "https://github.com/deliverybot/deliverybot/issues",
  "community": "https://spectrum.chat/deliverybot/general",
  "github": "https://github.com/deliverybot",
  "keywords": [
    "probot",
    "github",
    "probot-app"
  ]
}
