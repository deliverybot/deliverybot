{
  "name": "@deliverybot/app",
  "version": "0.7.2",
  "type": "module",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "views/*",
    "public/*",
    "lib/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:watch": "tsc -b --watch --preserveWatchOutput",
    "partials": "./build.cjs build",
    "partials:watch": "./build.cjs watch",
    "clean": "rm -rf lib",
    "test": "NODE_ENV=test vitest run"
  },
  "dependencies": {
    "@deliverybot/core": "0.7.2",
    "@deliverybot/deploybot": "0.7.2",
    "@deliverybot/slackbot": "0.7.2",
    "@octokit/request": "10.0.16",
    "js-yaml": "4.3.2",
    "lodash.get": "4.4.2",
    "object-hash": "3.0.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/js-yaml": "4.0.9",
    "@types/lodash.get": "4.4.9",
    "@types/mustache": "^4.2.6",
    "@types/object-hash": "3.0.6",
    "@types/supertest": "7.2.1",
    "nock": "15.0.1",
    "probot": "14.3.2",
    "supertest": "7.3.1",
    "typescript": "5.6.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "walk": "^2.3.15"
  },
  "description": "Controls and configures deployments using the GitHub API.",
  "author": "Deliverybot <support@deliverybot.dev> (https://github.com/deliverybot/deliverybot)",
  "license": "MIT",
