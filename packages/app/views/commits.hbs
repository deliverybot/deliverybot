{{> repo_header}}

<nav class="UnderlineNav mt-2">
  <div class="content">
    <div class="UnderlineNav-body">
      <a href="/{{owner}}/{{repo}}" role="tab" title="Deploy" class="UnderlineNav-item" aria-current="page">Commits</a>
      <a href="/{{owner}}/{{repo}}/environments" role="tab" title="Environments" class="UnderlineNav-item">Environments</a>
      <a href="/{{owner}}/{{repo}}/deployments" role="tab" title="Deployments" class="UnderlineNav-item">Deployments</a>
      <a href="/{{owner}}/{{repo}}/config" role="tab" title="Config" class="UnderlineNav-item">Config</a>
      <a href="/{{owner}}/{{repo}}/metrics" role="tab" title="Config" class="UnderlineNav-item">Metrics</a>
    </div>
  </div>
</nav>
</header>

<main class="bg-white fill pt-3 pb-10"
  data-commits-owner="{{owner}}"
  data-commits-repo="{{repo}}"
  data-controller="commits">
  <div class="content fill">

    <div class="d-flex">
      <div class="flex-auto">
        <details class="dropdown details-reset details-overlay d-inline-block"
          data-controller="filter" data-action="toggle->filter#toggle keydown->filter#keydown">
          <summary class="btn btn-sm" aria-haspopup="true">
            <div class="dropdown-caret"></div>
            Branch: {{branch}}
          </summary>
          <div class="dropdown-menu dropdown-menu-se filter-menu">
            <div class="px-2 pb-1">
              <input type="text" class="form-control input-sm input-block" placeholder="Filter branches"
                aria-label="Filter branches" autocomplete="off" data-target="filter.input" data-action="input->filter#filter">
            </div>
            <ul class="list-style-none filter-menu-list">
              {{#each branches}}
              <li data-target="filter.item">
                <a href="/{{../owner}}/{{../repo}}/branch/{{branchencode name}}" class="dropdown-item">
                  <code>{{name}}</code>
                </a>
              </li>
              {{/each}}
            </ul>
            <div class="px-3 py-1 text-gray d-none" data-target="filter.empty">No matching branches</div>
          </div>
        </details>
      </div>
      <div data-target="commits.lockstates">
        {{> lock_states}}
      </div>
      <div class="d-inline-block ml-2" data-target="commits.lock">
        {{> lock_modal}}
      </div>
      <div class="d-inline-block d-none ml-2" data-target="commits.new">
        <a class="btn btn-outline btn-sm" href="/{{owner}}/{{repo}}/branch/{{branch}}">New commits available</a>
      </div>
    </div>

    {{> config_alert}}

    <div class="Box mt-3" data-target="commits.rows" id="commit_rows">
      {{> commit_rows}}
    </div>

    {{> pagination}}
  </div>

</main>

{{> footer}}
