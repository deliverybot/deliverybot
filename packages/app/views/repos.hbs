{{> header}}

<div class="content page-header mt-5">
  <h2>
    {{install.name}}
  </h2>
  <div>
    <a data-track="add-integration" data-action="click->analytics#trackEvent" target="_blank"
      href="{{info.integrations}}" class="btn">
      + Integration
    </a>
    <a data-track="add-install" data-action="click->analytics#trackEvent" target="_blank" href="{{info.install}}"
      class="btn btn-primary">
      + Install
    </a>
  </div>
</div>

<nav class="UnderlineNav mt-2">
  <div class="content">
    <div class="UnderlineNav-body">
      <a href="/{{install.name}}" role="tab" title="Repositories" class="UnderlineNav-item"{{#unless setup}} aria-current="page"{{/unless}}>Repositories</a>
      <a href="/{{install.name}}?tab=setup" role="tab" title="Repositories to set up" class="UnderlineNav-item"{{#if setup}} aria-current="page"{{/if}}>Set up</a>
    </div>
  </div>
</nav>
</header>

<main class="color-bg-default fill pt-3 pb-8">
  <div class="content" data-controller="recents">
    {{#if hasRepos}}
    <div class="d-md-flex flex-items-start mt-3">
      <div class="col-12 col-md-8 pr-md-4" data-target="repos.list">
        <div class="Box">
        {{#each repos}}
        <div class="Box-row">
          {{#if setupUrl}}
          <a class="btn btn-sm float-right ml-2" target="_blank" href="{{setupUrl}}">Add deploy.yml</a>
          {{/if}}
          <h4>
            <a data-name="{{owner}}/{{repo}}" data-action="click->recents#addRecent"
              href="/{{owner}}/{{repo}}"><strong>{{owner}}&nbsp;/&nbsp;{{repo}}</strong></a>
          </h4>
          {{#if description}}
          <p>{{description}}</p>
          {{/if}}
          {{#if stats.lastDeploy}}
          <p class="color-fg-muted f6">
            Last deployed {{stats.lastDeploy.createdAt}}
            by {{stats.lastDeploy.creator}}
            with status {{stats.lastDeploy.state}}
          </p>
          {{/if}}
        </div>
        {{/each}}
        </div>
        {{> pagination}}
      </div>
      <div class="col-12 col-md-4 mt-4 mt-md-0">
        <div class="Box mb-4" data-controller="recents">
          <div class="Box-body">
            <h4 class="mb-3">Recent repositories</h4>
            <div data-target="recents.recents"></div>
          </div>
        </div>
        <div class="Box">
          <div class="Box-body">
            <h4 class="mb-3">Welcome to Deliverybot!</h4>
            <p>
              Ready to get deploying? Visit one of your repositories to the left
              or <a href="{{info.install}}">install</a> Deliverybot on a new account.
            </p>
          </div>
        </div>
      </div>
    </div>
    {{else if setup}}
    <div class="text-center">
      <p class="lead">
        Every repository Deliverybot can reach already has a deploy config.
      </p>
      <a class="btn btn-outline" role="button" target="_blank" href="{{info.install}}">
        Add repositories
      </a>
    </div>
    {{else}}
    <div class="text-center">
      <p class="lead">
        None of your repositories have a <code>.github/deploy.yml</code> yet.
      </p>
      <a class="btn btn-outline" role="button" href="/{{install.name}}?tab=setup">
        Set one up
      </a>
    </div>
    {{/if}}
  </div>
</main>

{{> footer}}
