{{> header}}

<div class="content page-header mt-5">
  <h2>
    <a href="/_/admin">Admin</a> / {{install.account}}
  </h2>
  <div>
    <a target="_blank" href="https://github.com/{{install.account}}" class="btn">
      View on GitHub
    </a>
  </div>
</div>

<nav class="UnderlineNav mt-2">
  <div class="content">
    <div class="UnderlineNav-body p-3">
      <span class="color-fg-muted">
        {{install.accountType}} &middot; {{install.repositorySelection}} repositories
        {{#if install.suspended}}&middot; <span class="Label Label--severe">Suspended</span>{{/if}}
      </span>
    </div>
  </div>
</nav>
</header>

<main class="color-bg-default fill pt-3 pb-8">
  <div class="content">
    <div class="Subhead mb-0 mt-5">
      <h2 class="Subhead-heading">Configured repositories</h2>
      <div class="Subhead-description">Repositories with a <code>.github/deploy.yml</code> on their default branch.</div>
    </div>
    {{#if hasConfigured}}
    <div class="overflow-x-auto mt-3">
    <table class="width-full" data-test="configured">
      <thead>
        <tr class="text-left border-bottom">
          <th class="p-2">Repository</th>
          <th class="p-2">Last event</th>
          <th class="p-2">When</th>
        </tr>
      </thead>
      <tbody>
        {{#each configured}}
        <tr class="border-bottom">
          <td class="p-2"><a target="_blank" href="https://github.com/{{fullName}}"><strong>{{fullName}}</strong></a></td>
          <td class="p-2">{{#if lastEvent}}<code>{{lastEvent}}</code>{{else}}<span class="color-fg-muted">None recorded</span>{{/if}}</td>
          <td class="p-2 color-fg-muted no-wrap">{{lastEventAgo}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    </div>
    {{else if configsChecked}}
    <p class="mt-3 color-fg-muted">None of this installation's repositories have a deploy config.</p>
    {{else}}
    <p class="mt-3 color-fg-muted">Not checked yet. The worker checks this installation when it next starts.</p>
    {{/if}}

    {{#if hasRecent}}
    <div class="Subhead mb-0 mt-5">
      <h2 class="Subhead-heading">Recent activity</h2>
    </div>
    <div class="overflow-x-auto mt-3">
    <table class="width-full" data-test="recent">
      <thead>
        <tr class="text-left border-bottom">
          <th class="p-2">Repository</th>
          <th class="p-2">Last event</th>
          <th class="p-2">When</th>
        </tr>
      </thead>
      <tbody>
        {{#each recent}}
        <tr class="border-bottom">
          <td class="p-2"><a target="_blank" href="https://github.com/{{fullName}}"><strong>{{fullName}}</strong></a></td>
          <td class="p-2"><code>{{lastEvent}}</code></td>
          <td class="p-2 color-fg-muted no-wrap">{{lastEventAgo}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    </div>
    {{/if}}

    <div class="Subhead mb-0 mt-6">
      <h2 class="Subhead-heading">Repositories</h2>
      {{#unless reposError}}
      <div class="Subhead-description">{{total}} repositories</div>
      {{/unless}}
    </div>
    {{#if reposError}}
    <div class="flash flash-warn mt-3">
      Could not list this installation's repositories on GitHub.
    </div>
    {{else if hasRepos}}
    <div class="overflow-x-auto mt-3">
    <table class="width-full" data-test="repositories">
      <thead>
        <tr class="text-left border-bottom">
          <th class="p-2">Repository</th>
          <th class="p-2">Last event</th>
          <th class="p-2">When</th>
        </tr>
      </thead>
      <tbody>
        {{#each repos}}
        <tr class="border-bottom">
          <td class="p-2">
            <a target="_blank" href="https://github.com/{{fullName}}"><strong>{{fullName}}</strong></a>
            {{#if private}}<span class="Label ml-1">Private</span>{{/if}}
            {{#if configured}}<span class="Label Label--success ml-1">Configured</span>{{/if}}
          </td>
          <td class="p-2">{{#if lastEvent}}<code>{{lastEvent}}</code>{{else}}<span class="color-fg-muted">None recorded</span>{{/if}}</td>
          <td class="p-2 color-fg-muted no-wrap">{{lastEventAgo}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    </div>
    {{> pagination}}
    {{else}}
    <p class="mt-3 color-fg-muted">No repositories.</p>
    {{/if}}
  </div>
</main>

{{> footer}}
