{
  "compilerOptions": {
    "allowJs": false,
    "lib": [
      "es2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2022",
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "pretty": true,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "sourceMap": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "tsBuildInfoFile": "./lib/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "declaration": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "src/@types",
      "../../node_modules/@types",
      "node_modules/@types"
    ],
    "composite": true
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    { "path": "../core" },
    { "path": "../deploybot" }
  ],
  "compileOnSave": false
}
