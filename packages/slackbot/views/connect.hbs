{{> header}}
<div class="d-flex flex-column flex-justify-center flex-items-center text-center height-full">
  <img src="https://deliverybot.dev/assets/logos/logo-bg.png" alt="Deliverybot logo" width="100" class="mb-6">
  <div class="color-shadow-small rounded-2 border p-6 color-bg-default" style="max-width: 400px;">
    <h1>Connect with GitHub</h1>
    <p>
      You've authenticated with Slack! Now we need to connect you to your
      GitHub account. Click the button below to authorize your GitHub
      account.
    </p>
    <a class="btn btn-outline mt-3" href="/slack/associate">Connect with GitHub</a>
  </div>

  <div class="mt-6 text-center">
    <h4 class="h4 color-fg-muted">Need help?</h4>
    <div class="d-flex flex-justify-center mt-2">
      <a href="https://deliverybot.dev" class="btn btn-outline mr-2">Documentation</a>
    </div>
  </div>
</div>
{{> footer}}
